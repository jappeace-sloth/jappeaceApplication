cabal-version:      3.0
name:               shake-blog
version:            0.1.0
license:            MIT
author:             Jappie Klooster
maintainer:         hi@jappie.me
build-type:         Simple

executable shake-blog
  main-is:          Shakefile.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:
    -O2 -Wall -Werror
    -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base >=4.9 && <4.22
    , shake >=0.19 && <0.20
    , pandoc >=3.0 && <3.8
    , text >=1.2 && <2.2
    , filepath >=1.4 && <1.6
    , directory >=1.3 && <1.5
